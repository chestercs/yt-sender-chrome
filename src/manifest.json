{
  "manifest_version": 3,
  "name": "YT Sender",
  "short_name": "YT Sender",
  "version": "2.0.0",
  "description": "Send the current video link (toolbar/context menu) to your self-hosted yt-dlp-web-ui v4 instance.",
  "action": {
    "default_title": "Send to YTdownloader",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon48.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": [],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "minimum_chrome_version": "102",
  "homepage_url": "https://github.com/chestercs/yt-sender-chrome"
}
