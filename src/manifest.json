{
  "manifest_version": 3,
  "name": "YT Sender",
  "short_name": "YT Sender",
  "version": "1.0.0",
  "description": "Send the current video link (toolbar/context menu) to your self-hosted YTdownloader instance.",
  "action": {
    "default_title": "Send to YTdownloader",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon48.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },

  "permissions": [
    "storage",
    "tabs",
    "contextMenus"
  ],

  "host_permissions": [
    // intentionally empty: we request the downloader host at runtime
  ],

  "optional_host_permissions": [
    "*://*/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "options_page": "options.html",

  "minimum_chrome_version": "88",

  "author": "You",
  "homepage_url": "https://github.com/chestercs/yt-sender-chrome"
}
